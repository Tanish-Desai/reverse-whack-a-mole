# Copy to .env for `netlify dev`. .env is gitignored; this file is not, so
# never put a real value here.
#
# The deployed site does NOT read this file — set ADMIN_TOKEN in Netlify
# (Site configuration -> Environment variables) and redeploy. Use a
# different value locally than in production.
#
#   openssl rand -base64 32
ADMIN_TOKEN=
